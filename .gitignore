# ── Secrets & environment ─────────────────────────────────────────────────────
.env
*.env
!.env.example          # keep the example template

# ── Python bytecode & caches ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Test / coverage caches ────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# ── DeepEval cache ────────────────────────────────────────────────────────────
.deepeval/

# ── Audit trail (runtime-generated data, not source) ─────────────────────────
audit_trail.jsonl

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build / dist artefacts ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── IDE & editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Streamlit local config ────────────────────────────────────────────────────
.streamlit/secrets.toml
